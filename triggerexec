#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import sys
import os
import glob
import re
import subprocess
import pygame

CONFIG_DIR = "/etc/triggerexec.d"
VERBOSE = "-v" in sys.argv or "--verbose" in sys.argv
ANALOG_THRESHOLD = 0.7  # Seuil de déclenchement pour les sticks et gâchettes

def load_configs_from_dir(dir_path):
    """Charge et parse tous les fichiers de configuration du dossier triggerexec.d."""
    device_rules = []
    if not os.path.exists(dir_path):
        os.makedirs(dir_path, exist_ok=True)
        return device_rules

    pattern = os.path.join(dir_path, "*.conf")
    for filepath in glob.glob(pattern):
        device_filter = None
        global_rules = {}
        app_rules = {}
        current_app = None
        
        with open(filepath, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                
                if line.startswith("[") and line.endswith("]"):
                    current_app = line[1:-1].strip()
                    app_rules[current_app] = {}
                    continue
                
                if "=" in line:
                    # On sépare la ligne au niveau du premier signe '=' qui sépare la clé de la commande,
                    # en s'assurant de gérer les clés contenant déjà un '=' (ex: ABS_HAT0Y=-1 = commande)
                    # Astuce : le '=' de séparation clé/valeur est celui qui précède la commande (/usr/... ou similaire)
                    # Ou plus simplement, on sépare par le premier '=' s'il n'y a pas d'autre '=' dans la clé.
                    
                    # Découpage intelligent : tout ce qui est avant le premier '=' qui n'est pas dans un token de gauche
                    # On peut chercher le dernier '=' avant le début de la commande ou séparer par le '=' principal.
                    # Ici, les commandes commencent toutes par '/' ou un chemin. On peut séparer par le dernier '=' 
                    # si la clé contient un '=', ou utiliser une regex.
                    
                    if "/" in line:
                        left_part, val = line.split("=", 1)
                        # S'il y a un autre '=' dans la partie gauche (ex: ABS_HAT0Y=-1), on doit le conserver dans la clé.
                        # En fait, la structure est : [cle_complexe] = [commande]
                        # Le '=' de séparation est celui qui est suivi d'un espace ou juste avant la commande.
                        # Ajustons le split : on cherche le '=' qui sépare la config de la commande.
                        pass
                    
                    # Approche robuste par Regex pour chaque ligne de configuration :
                    # Capture tout ce qui est à gauche (avec des + et des =) et tout ce qui est à droite (la commande)
                    match = re.match(r'^([^=]+(?:=[+-]?\d+)?(?:\s*\+\s*[^=]+(?:=[+-]?\d+)?)*)\s*=\s*(.*)$', line)
                    if not match:
                        # Fallback sur l'ancien split si la regex ne matche pas
                        parts = line.split("=", 1)
                        key_part, val = parts[0].strip(), parts[1].strip()
                    else:
                        key_part, val = match.groups()
                        key_part = key_part.strip()
                        val = val.strip()
                    
                    if key_part.upper() == "DEVICE" and current_app is None and not global_rules:
                        device_filter = val
                        continue
                    
                    raw_tokens = key_part.split("+")
                    cleaned_tokens = []
                    for token in raw_tokens:
                        token = token.strip().upper()
                        # Si le token ne contient pas déjà d'opérateur (=1 ou =-1), on lui ajoute "=1" par défaut
                        if "=" not in token:
                            token = f"{token}=1"
                        cleaned_tokens.append(token)
                    
                    # Tri alphabétique pour garantir l'invariabilité de l'ordre des combinaisons
                    combo = "".join(sorted(cleaned_tokens))
                    
                    if current_app is None:
                        global_rules[combo] = val
                    else:
                        app_rules[current_app][combo] = val
                        
        device_rules.append({
            "file": os.path.basename(filepath),
            "filter": device_filter,
            "globals": global_rules,
            "apps": app_rules
        })
        
    return device_rules
    
def get_active_window_class():
    """Interroge KWin via kdotool pour obtenir la classe de la fenêtre active."""
    try:
        # 1. Récupère l'ID de la fenêtre active
        res_win = subprocess.run(
            ["kdotool", "getactivewindow"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
        )
        win_id = res_win.stdout.strip()
        if not win_id:
            return ""
        
        # 2. Récupère la classe de cette fenêtre
        result = subprocess.run(
            ["kdotool", "getwindowclassname", win_id],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
        )
        return result.stdout.strip()
    except Exception:
        return ""

def execute_command(cmd, combo_str=""):
    """Exécute la commande shell configurée."""
    if VERBOSE:
        print(f"[INPUT] -> {combo_str} -> {cmd}")
    else:
        print(f"[EXEC] {cmd}")
    subprocess.Popen(cmd, shell=True)

def resolve_and_execute(active_keys, matched_configs):
    """Résout la combinaison active en fonction de la fenêtre courante et exécute l'action."""
    if not active_keys:
        return
    
    combo_str = "".join(sorted(list(active_keys)))
    win_class = get_active_window_class()
    
    if VERBOSE:
        print(f"[DEBUG] Combo évaluée: '{combo_str}' | Fenêtre active: '{win_class}'")

    # 1. Priorité aux règles spécifiques des applications actives
    for cfg in matched_configs:
        for app_name, rules in cfg["apps"].items():
            if app_name.lower() in win_class.lower() and combo_str in rules:
                execute_command(rules[combo_str], combo_str)
                return

    # 2. Repli sur les règles globales
    for cfg in matched_configs:
        if combo_str in cfg["globals"]:
            execute_command(cfg["globals"][combo_str], combo_str)
            return
        elif VERBOSE:
            print(f"[DEBUG] Clé '{combo_str}' non trouvée dans les globals du fichier {cfg['file']}. Disponibles: {list(cfg['globals'].keys())}")

def main():
    os.environ["SDL_VIDEODRIVER"] = "dummy"
    pygame.init()
    pygame.joystick.init()

    configs = load_configs_from_dir(CONFIG_DIR)
    print(f"Chargement de {len(configs)} fichier(s) de configuration depuis {CONFIG_DIR}.")
    
    if VERBOSE:
        print("=== DUMP DES RÈGLES CHARGÉES ===")
        import pprint
        pprint.pprint(configs)
        print("================================")

    joysticks = {}
    active_keys = set()

    for i in range(pygame.joystick.get_count()):
        joy = pygame.joystick.Joystick(i)
        joy.init()
        joysticks[joy.get_id()] = joy
        print(f"Écoute active sur : {joy.get_name()}")

    clock = pygame.time.Clock()

    while True:
        for event in pygame.event.get():
            if event.type == pygame.JOYDEVICEADDED:
                joy = pygame.joystick.Joystick(event.device_index)
                joy.init()
                joysticks[joy.get_id()] = joy
                print(f"Manette connectée : {joy.get_name()}")

            elif event.type == pygame.JOYDEVICEREMOVED:
                if event.instance_id in joysticks:
                    print("Manette déconnectée")
                    del joysticks[event.instance_id]

            elif event.type == pygame.JOYBUTTONDOWN:
                key_name = f"BTN_{event.button}=1"
                if VERBOSE:
                    print(f"[INPUT] -> {key_name}")
                active_keys.add(key_name)
                
                joy_name = pygame.joystick.Joystick(event.joy).get_name()
                matched_configs = [cfg for cfg in configs if cfg["filter"] is None or re.search(cfg["filter"], joy_name, re.IGNORECASE)]
                resolve_and_execute(active_keys, matched_configs)

            elif event.type == pygame.JOYBUTTONUP:
                key_name = f"BTN_{event.button}=1"
                if VERBOSE:
                    print(f"[INPUT] -> {key_name} (Relâché)")
                active_keys.discard(key_name)

            elif event.type == pygame.JOYHATMOTION:
                hat_x, hat_y = event.value
                hat_keys = {
                    f"ABS_HAT{event.hat}X=-1": hat_x < 0,
                    f"ABS_HAT{event.hat}X=1":  hat_x > 0,
                    f"ABS_HAT{event.hat}Y=-1": hat_y < 0,
                    f"ABS_HAT{event.hat}Y=1":  hat_y > 0
                }
                
                for hkey, pressed in hat_keys.items():
                    if pressed:
                        if hkey not in active_keys:
                            active_keys.add(hkey)
                            if VERBOSE:
                                print(f"[INPUT] -> {hkey}")
                            joy_name = pygame.joystick.Joystick(event.joy).get_name()
                            matched_configs = [cfg for cfg in configs if cfg["filter"] is None or re.search(cfg["filter"], joy_name, re.IGNORECASE)]
                            resolve_and_execute(active_keys, matched_configs)
                    else:
                        active_keys.discard(hkey)

            elif event.type == pygame.JOYAXISMOTION:
                val = event.value
                axis_pos_key = f"AXIS_{event.axis}=1"
                axis_neg_key = f"AXIS_{event.axis}=-1"
                
                pos_pressed = val > ANALOG_THRESHOLD
                neg_pressed = val < -ANALOG_THRESHOLD
                
                if pos_pressed:
                    if axis_pos_key not in active_keys:
                        active_keys.add(axis_pos_key)
                        if VERBOSE:
                            print(f"[INPUT] -> {axis_pos_key} (val: {val:.2f})")
                        joy_name = pygame.joystick.Joystick(event.joy).get_name()
                        matched_configs = [cfg for cfg in configs if cfg["filter"] is None or re.search(cfg["filter"], joy_name, re.IGNORECASE)]
                        resolve_and_execute(active_keys, matched_configs)
                else:
                    active_keys.discard(axis_pos_key)
                
                if neg_pressed:
                    if axis_neg_key not in active_keys:
                        active_keys.add(axis_neg_key)
                        if VERBOSE:
                            print(f"[INPUT] -> {axis_neg_key} (val: {val:.2f})")
                        joy_name = pygame.joystick.Joystick(event.joy).get_name()
                        matched_configs = [cfg for cfg in configs if cfg["filter"] is None or re.search(cfg["filter"], joy_name, re.IGNORECASE)]
                        resolve_and_execute(active_keys, matched_configs)
                else:
                    active_keys.discard(axis_neg_key)

        clock.tick(100)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nArrêt de triggerexec.")
