#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import sys
import os
import glob
import re
import subprocess
import pygame

CONFIG_DIR = "/etc/triggerexec.d"
VERBOSE = "-v" in sys.argv or "--verbose" in sys.argv
ANALOG_THRESHOLD = 0.7

JOYSTICK_MAPPINGS = {
    "Xbox 360 Controller": {
        "BTN_A": "BTN_0=1",
        "BTN_B": "BTN_1=1",
        "BTN_X": "BTN_2=1",
        "BTN_Y": "BTN_3=1",
        "BTN_TL": "BTN_4=1",
        "BTN_TR": "BTN_5=1",
        "BTN_SELECT": "BTN_6=1",
        "BTN_START": "BTN_7=1",
        "BTN_MODE": "BTN_8=1",
		"DOWN": "ABS_HAT0Y=-1",
        "UP": "ABS_HAT0Y=1",
        "LEFT": "ABS_HAT0X=-1",
        "RIGHT": "ABS_HAT0X=1"
    },
}

current_combo_snapshot = set()

def load_configs_from_dir(dir_path):
    device_rules = []
    if not os.path.exists(dir_path):
        os.makedirs(dir_path, exist_ok=True)
        return device_rules

    pattern = os.path.join(dir_path, "*.conf")
    for filepath in glob.glob(pattern):
        device_filter = None
        blacklist_filter = None
        global_rules = {}
        app_rules = {}
        current_app = None
        
        with open(filepath, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                
                if line.startswith("[") and line.endswith("]"):
                    current_app = line[1:-1].strip()
                    app_rules[current_app] = {}
                    continue
                
                if "=" in line:
                    parts = line.split("=", 1)
                    key_part, val = parts[0].strip(), parts[1].strip()
                else:
                    continue
                
                if key_part.upper() == "DEVICE" and current_app is None:
                    device_filter = val
                    continue
                
                if key_part.upper() == "BLACKLIST" and current_app is None:
                    blacklist_filter = val
                    continue
                
                raw_tokens = key_part.split("+")
                cleaned_tokens = []
                for token in raw_tokens:
                    token = token.strip()
                    resolved = token
                    for joy_name_pat, mapping in JOYSTICK_MAPPINGS.items():
                        if token in mapping:
                            resolved = mapping[token]
                            break
                    cleaned_tokens.append(resolved)
                
                combo = "+".join(sorted(cleaned_tokens))
                
                if current_app is None:
                    global_rules[combo] = val
                else:
                    app_rules[current_app][combo] = val
                    
        device_rules.append({
            "file": os.path.basename(filepath),
            "filter": device_filter,
            "blacklist": blacklist_filter,
            "globals": global_rules,
            "apps": app_rules
        })
        
    return device_rules
    
def get_active_session_info():
    try:
        sessions_out = subprocess.check_output(["loginctl", "list-sessions", "--no-legend"], text=True)
        
        for line in sessions_out.strip().split("\n"):
            if not line: continue
            parts = line.split()
            session_id, uid, user = parts[0], parts[1], parts[2]
            
            props_raw = subprocess.check_output(["loginctl", "show-session", session_id], text=True)
            props = dict(p.split("=", 1) for p in props_raw.strip().split("\n") if "=" in p)
            
            if props.get("State") == "active" and props.get("Type") in ["wayland", "x11"]:
                return uid, user
                
    except Exception as e:
        if VERBOSE:
            print(f"[DEBUG] Erreur lors de la détection de session : {e}")
            
    return None, None
    
def get_active_window_class():
    uid, user = get_active_session_info()
    
    if not uid or not user:
        if VERBOSE:
            print("[DEBUG-KDO] Aucune session graphique active trouvée.")
        return ""

    try:
        wayland_displays = glob.glob(f"/run/user/{uid}/wayland-*")
        wayland_socket = "wayland-0"
        if wayland_displays:
            valid_sockets = [s for s in wayland_displays if not s.endswith('.lock')]
            if valid_sockets:
                wayland_socket = os.path.basename(valid_sockets[0])
        
        dbus_address = f"unix:path=/run/user/{uid}/bus"
        xdg_runtime_dir = f"/run/user/{uid}"

        if VERBOSE:
            print(f"[DEBUG-KDO] Exécution pour l'utilisateur: {user} | WAYLAND_DISPLAY: {wayland_socket}")

        base_cmd = [
            "sudo", "-u", user,
            "env",
            f"XDG_RUNTIME_DIR={xdg_runtime_dir}",
            f"DISPLAY=:0",
            f"WAYLAND_DISPLAY={wayland_socket}",
            f"DBUS_SESSION_BUS_ADDRESS={dbus_address}"
        ]

        res_win = subprocess.run(
            base_cmd + ["kdotool", "getactivewindow"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
        )
        win_id = res_win.stdout.strip()
        
        if VERBOSE and res_win.stderr:
            print(f"[DEBUG-KDO] Erreur kdotool (getactivewindow) : {res_win.stderr.strip()}")
        
        if not win_id:
            if VERBOSE:
                print("[DEBUG-KDO] Aucun ID de fenêtre retourné.")
            return ""
            
        if VERBOSE:
            print(f"[DEBUG-KDO] ID de la fenêtre : {win_id}")
            
        result = subprocess.run(
            base_cmd + ["kdotool", "getwindowclassname", win_id],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
        )
        
        if VERBOSE and result.stderr:
            print(f"[DEBUG-KDO] Erreur kdotool (getwindowclassname) : {result.stderr.strip()}")
            
        return result.stdout.strip()
        
    except Exception as e:
        if VERBOSE:
            print(f"[DEBUG-KDO] Exception fatale : {e}")
        return ""

def execute_command(cmd, combo_str=""):
    if VERBOSE:
        print(f"[INPUT] -> {combo_str} -> {cmd}")
    else:
        print(f"[EXEC] {cmd}")
    subprocess.Popen(cmd, shell=True)

def resolve_and_execute(keys_to_evaluate, matched_configs, joy_name=""):
    if not keys_to_evaluate:
        if VERBOSE:
            print("[DEBUG] resolve_and_execute: keys_to_evaluate est vide.")
        return
    
    sorted_tokens = sorted(list(keys_to_evaluate))
    combo_str = "+".join(sorted_tokens)
    
    win_class = get_active_window_class()
    
    if VERBOSE:
        print(f"[DEBUG-TRACE] === DÉBUT RÉSOLUTION ===")
        print(f"[DEBUG-TRACE] Combo finale cherchée: '{combo_str}'")
        print(f"[DEBUG-TRACE] Fenêtre active détectée: '{win_class}'")
        print(f"[DEBUG-TRACE] Nombre de configs correspondantes: {len(matched_configs)}")

    # 1. Priorité absolue aux règles spécifiques des applications actives (même en cas de blacklist globale)
    for idx, cfg in enumerate(matched_configs):
        if VERBOSE:
            print(f"[DEBUG-TRACE] --- Config #{idx} ({cfg['file']}) [Test Apps] ---")
        for app_name, rules in cfg["apps"].items():
            if app_name.lower() in win_class.lower():
                if VERBOSE:
                    print(f"[DEBUG-TRACE] -> Application correspondante trouvée: '{app_name}'")
                if combo_str in rules:
                    if VERBOSE:
                        print(f"[DEBUG-TRACE] -> Trouvé dans les règles spécifiques de l'app (combo exacte) !")
                    execute_command(rules[combo_str], combo_str)
                    return
                if len(sorted_tokens) == 1 and sorted_tokens[0] in rules:
                    if VERBOSE:
                        print(f"[DEBUG-TRACE] -> Trouvé dans les règles spécifiques de l'app (token unique) !")
                    execute_command(rules[sorted_tokens[0]], sorted_tokens[0])
                    return

    # 2. Vérification de la blacklist globale pour bloquer uniquement les règles globales
    for cfg in matched_configs:
        if cfg.get("blacklist"):
            blacklisted_patterns = cfg["blacklist"].split()
            for pattern in blacklisted_patterns:
                if re.search(pattern, win_class, re.IGNORECASE):
                    if VERBOSE:
                        print(f"[DEBUG-TRACE] -> Fenêtre '{win_class}' blackant les règles globales (correspond à '{pattern}' dans {cfg['file']}).")
                        print(f"[DEBUG-TRACE] === FIN RÉSOLUTION (Règles globales ignorées par blacklist) ===")
                    return

    # 3. Repli sur les règles globales si non blacklisté
    if VERBOSE:
        print(f"[DEBUG-TRACE] Passage aux règles globales...")
    for idx, cfg in enumerate(matched_configs):
        if VERBOSE:
            print(f"[DEBUG-TRACE] --- Globaux Config #{idx} ({cfg['file']}) ---")
        if combo_str in cfg["globals"]:
            if VERBOSE:
                print(f"[DEBUG-TRACE] -> Trouvé dans les globals (combo exacte) !")
            execute_command(cfg["globals"][combo_str], combo_str)
            return
        elif len(sorted_tokens) == 1 and sorted_tokens[0] in cfg["globals"]:
            if VERBOSE:
                print(f"[DEBUG-TRACE] -> Trouvé dans les globals (token unique) !")
            execute_command(cfg["globals"][sorted_tokens[0]], sorted_tokens[0])
            return

    if VERBOSE:
        print(f"[DEBUG-TRACE] === FIN RÉSOLUTION : AUCUNE RÈGLE CORRESPONDANTE TROUVÉE ===")

def main():
    global current_combo_snapshot
    os.environ["SDL_VIDEODRIVER"] = "dummy"
    pygame.init()
    pygame.joystick.init()

    configs = load_configs_from_dir(CONFIG_DIR)
    print(f"Chargement de {len(configs)} fichier(s) de configuration depuis {CONFIG_DIR}.")
    
    if VERBOSE:
        print("=== DUMP DES RÈGLES CHARGÉES ===")
        import pprint
        pprint.pprint(configs)
        print("================================")

    joysticks = {}
    active_keys = set()

    for i in range(pygame.joystick.get_count()):
        joy = pygame.joystick.Joystick(i)
        joy.init()
        joysticks[joy.get_id()] = joy
        print(f"Écoute active sur : {joy.get_name()}")

    clock = pygame.time.Clock()

    def handle_release_event(joy_id):
        nonlocal active_keys
        if not active_keys and current_combo_snapshot:
            try:
                joy_name = pygame.joystick.Joystick(joy_id).get_name()
            except pygame.error:
                joy_name = ""
            matched_configs = [cfg for cfg in configs if cfg["filter"] is None or re.search(cfg["filter"], joy_name, re.IGNORECASE)]
            resolve_and_execute(current_combo_snapshot, matched_configs, joy_name)
            current_combo_snapshot.clear()

    while True:
        for event in pygame.event.get():
            if event.type == pygame.JOYDEVICEADDED:
                joy = pygame.joystick.Joystick(event.device_index)
                joy.init()
                joysticks[joy.get_id()] = joy
                print(f"Manette connectée : {joy.get_name()}")

            elif event.type == pygame.JOYDEVICEREMOVED:
                if event.instance_id in joysticks:
                    print("Manette déconnectée")
                    del joysticks[event.instance_id]

            elif event.type == pygame.JOYBUTTONDOWN:
                key_name = f"BTN_{event.button}=1"
                if VERBOSE:
                    print(f"[INPUT] -> {key_name} (Enfoncé)")
                active_keys.add(key_name)
                current_combo_snapshot.add(key_name)

            elif event.type == pygame.JOYBUTTONUP:
                key_name = f"BTN_{event.button}=1"
                if VERBOSE:
                    print(f"[INPUT] -> {key_name} (Relâché)")
                
                active_keys.discard(key_name)
                handle_release_event(event.joy)

            elif event.type == pygame.JOYHATMOTION:
                hat_x, hat_y = event.value
                hat_keys = {
                    f"ABS_HAT{event.hat}X=-1": hat_x < 0,
                    f"ABS_HAT{event.hat}X=1":  hat_x > 0,
                    f"ABS_HAT{event.hat}Y=-1": hat_y < 0,
                    f"ABS_HAT{event.hat}Y=1":  hat_y > 0
                }
                
                for hkey, pressed in hat_keys.items():
                    if pressed:
                        if hkey not in active_keys:
                            active_keys.add(hkey)
                            current_combo_snapshot.add(hkey)
                            if VERBOSE:
                                print(f"[INPUT] -> {hkey} (Enfoncé)")
                    else:
                        if hkey in active_keys:
                            if VERBOSE:
                                print(f"[INPUT] -> {hkey} (Relâché)")
                            active_keys.discard(hkey)
                            handle_release_event(event.joy)

            elif event.type == pygame.JOYAXISMOTION:
                val = event.value
                axis_pos_key = f"AXIS_{event.axis}=1"
                axis_neg_key = f"AXIS_{event.axis}=-1"
                
                pos_pressed = val > ANALOG_THRESHOLD
                neg_pressed = val < -ANALOG_THRESHOLD
                
                if pos_pressed:
                    if axis_pos_key not in active_keys:
                        active_keys.add(axis_pos_key)
                        if VERBOSE:
                            print(f"[INPUT] -> {axis_pos_key} (Enfoncé, val: {val:.2f})")
                else:
                    if axis_pos_key in active_keys:
                        if VERBOSE:
                            print(f"[INPUT] -> {axis_pos_key} (Relâché)")
                        active_keys.discard(axis_pos_key)
                
                if neg_pressed:
                    if axis_neg_key not in active_keys:
                        active_keys.add(axis_neg_key)
                        if VERBOSE:
                            print(f"[INPUT] -> {axis_neg_key} (Enfoncé, val: {val:.2f})")
                else:
                    if axis_neg_key in active_keys:
                        if VERBOSE:
                            print(f"[INPUT] -> {axis_neg_key} (Relâché)")
                        active_keys.discard(axis_neg_key)

        clock.tick(100)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nArrêt de triggerexec.")
